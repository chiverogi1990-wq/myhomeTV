<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Витрина: фон меняет цвет под выбранное приложение -->
    <View
        android:id="@+id/hero_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/hero_shade" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Верхняя панель -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="56dp"
            android:paddingTop="28dp"
            android:paddingEnd="56dp">

            <TextView
                android:id="@+id/greeting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_main"
                android:textSize="22sp" />

            <ImageButton
                android:id="@+id/btn_network"
                style="@style/TopButton"
                android:contentDescription="@string/menu_network"
                android:src="@android:drawable/ic_menu_share" />

            <ImageButton
                android:id="@+id/btn_settings"
                style="@style/TopButton"
                android:contentDescription="@string/menu_settings"
                android:src="@android:drawable/ic_menu_preferences" />

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/text_main"
                android:textSize="30sp" />
        </LinearLayout>

        <!-- Крупный заголовок витрины -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="56dp"
            android:paddingEnd="56dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/hero_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/text_main"
                android:textSize="52sp" />

            <TextView
                android:id="@+id/hero_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_dim"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Ряды плиток -->
        <LinearLayout
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="28dp" />
    </LinearLayout>
</FrameLayout>
